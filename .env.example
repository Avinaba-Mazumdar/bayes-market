# BayesMarket Environment Configuration
# Database: Neon Serverless PostgreSQL (https://neon.tech)
DATABASE_URL=postgres://user:password@ep-cool-pool-123456.us-east-2.aws.neon.tech/bayesmarket?sslmode=require

# Server Configuration
SERVER_PORT=8080
CORS_ORIGIN=http://localhost:4200

# Security (Stateless HMAC-SHA256 Secret for JWTs)
JWT_SECRET=bayesmarket-super-secret-random-key-32-chars-min
ADMIN_TOKEN=bayesmarket-admin-secret-token

# Google OAuth 2.0 (Optional for local dev simulation mode)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4200/auth/callback
